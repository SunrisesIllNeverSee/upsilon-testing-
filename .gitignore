# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local environment / secrets
.env

# macOS
.DS_Store

# Local data and generated outputs
# Use data/* (not data/) so that specific subpaths can be un-ignored
# with ! patterns below.  git cannot re-include a file if a parent
# directory is fully excluded.
data/*
results/*
*.log

# IDE
.vscode/
.idea/

# Research exception:
# Do NOT ignore research/run_records if you intentionally want to commit
# immutable formal run records after review.

# Freeze exception:
# The Step 18 freeze package is an immutable release artifact and must be
# version-controlled so the frozen hashes, report, and records are
# reproducible from the tagged commit.
!results/step_18_freeze/

# Step 19B.2 exception:
# The held-out run lock, mutation defect analysis, gold scope
# classification, and Track B status are immutable records that must be
# version-controlled for reproducibility.  The held-out study results
# JSON and the provisional report are also version-controlled so the
# locked predictions are reproducible.  Raw data/ and proxy gold files
# remain gitignored (large, and human gold is not yet locked).
!results/step_19b_held_out_run_lock.json
!results/step_19b_mutation_defect_analysis.json
!results/step_19b_gold_scope_classification.json
!results/step_19b_track_b_status.md
!results/step_19b_held_out_confirmatory_study.md
!results/step_19b_defect_safety_record.md
!results/held_out_study_results.json

# Post-migration baseline freeze (Step 23G-R rebaseline):
# The canonical baseline record and comparison script are version-controlled
# so the post-migration empirical equivalence is auditable.
!results/POST_MIGRATION_BASELINE_FREEZE.md

# Step 19B.3 note:
# The human gold annotation handoff package is generated by
# prepare_human_gold_handoff.py (tracked).  It lives in
# data/held_out/human_gold_handoff/ (gitignored, since data/ is
# gitignored).  The package is reproducible by running the script.
# Source text files are already hashed in the locked run manifest.

# Step 23G exception:
# The frozen ground-truth artifact inventory (manifest.json), its generator,
# and the README are version-controlled so the hash set is reproducible and
# CI can verify it.  The edgar_chain_states/ and semantic_gold/ subdirectories
# are empty until Phase 2 externalization.
!data/ground_truth/
!data/ground_truth/frozen/
!data/ground_truth/frozen/manifest.json
!data/ground_truth/frozen/generate_manifest.py
!data/ground_truth/frozen/README.md
!data/ground_truth/frozen/edgar_chain_states/
!data/ground_truth/frozen/semantic_gold/

# Step 23G source-corpus exception:
# The EDGAR chain source documents (data/edgar_chains/) are the frozen
# inputs that the ground-truth manifest hashes.  Only the .txt source
# evidence and the chain manifest.json are version-controlled so CI can
# verify that the source document hashes in
# data/ground_truth/frozen/manifest.json match the actual files.
#
# Derived .html and .v04.json artifacts are NOT tracked — they are
# regenerable parser/processing output and would add ~22 MB of bulk.
# The distinction is:
#   SOURCE EVIDENCE (.txt)       = version-controlled, hashed by manifest
#   DERIVED OUTPUT (.html/.json) = gitignored, regenerable
#
# The pattern below is general (wildcard over chain subdirectories) so
# new chain directories are handled without per-chain exceptions.
!data/edgar_chains/
data/edgar_chains/*
!data/edgar_chains/manifest.json
# Allow git to descend into chain subdirectories
!data/edgar_chains/*/
# Ignore everything inside chain subdirectories, then un-ignore only .txt
data/edgar_chains/*/*
!data/edgar_chains/*/*.txt
# Explicitly ignore derived parser/processing output (defense in depth)
data/edgar_chains/*/*.html
data/edgar_chains/*/*.v04.json
