      "6. Reject non-credit-agreement documents (anti-signals: lease, subscription, contribution, omnibus, joinder, warrant, etc.)",
      "7. Score candidates: +100 mentions_cross_ref_date, +50 is_ex10, +1 per 10K chars, -1 per day from CA date",
      "8. Select highest-scoring candidate"
    ],
    "provenance_resolution_only": true,
    "value_inference_prohibited": true
  },
